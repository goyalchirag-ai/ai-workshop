@baseUrl = http://127.0.0.1:5000
# Replace these with IDs from your users and events tables.
@userId = 11111111-1111-4111-8111-111111111111
@eventId = 33333333-3333-4333-8333-333333333333

### Health check
GET {{baseUrl}}/health

### Browse events
GET {{baseUrl}}/api/events

### Event details
GET {{baseUrl}}/api/events/{{eventId}}

### Register a user (201 created; 409 duplicate or full)
POST {{baseUrl}}/api/registrations
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "event_id": "{{eventId}}"
}

### A user's registrations, including event details
GET {{baseUrl}}/api/me/registrations?user_id={{userId}}

### Event attendees (no authentication or organizer ID required)
GET {{baseUrl}}/api/events/{{eventId}}/registrations
